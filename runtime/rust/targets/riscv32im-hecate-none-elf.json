{
    "arch": "riscv32",
    "cpu": "generic-rv32",
    "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
    "env": "",
    "executables": true,
    "exe-suffix": ".elf",
    "features": "+m",
    "linker-flavor": "gnu-lld",
    "linker": "rust-lld",
    "llvm-abiname": "ilp32",
    "llvm-target": "riscv32",
    "max-atomic-width": 32,
    "metadata": {
        "description": "Hecate custom RV32IM bare-metal target",
        "host_tools": false,
        "std": false,
        "tier": 3
    },
    "os": "none",
    "panic-strategy": "abort",
    "position-independent-executables": false,
    "relocation-model": "static",
    "target-c-int-width": 32,
    "target-endian": "little",
    "target-pointer-width": 32,
    "vendor": "hecate"
}